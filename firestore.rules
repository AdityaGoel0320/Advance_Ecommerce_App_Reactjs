rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function ownsOrders(email) {
      return request.auth != null && request.auth.token.email == email;
    }

    function validNewOrder(email) {
      let orders = request.resource.data.orders;
      let order = orders[orders.size() - 1];
      return orders is list && orders.size() > 0
        && order is map
        && order.keys().hasAll(['paymentId', 'paymentMethod', 'userEmail', 'orderItems'])
        && order.userEmail == email
        && order.paymentMethod == 'stripe'
        && order.paymentId is string
        && order.paymentId.matches('cs_[a-zA-Z0-9_]+')
        && order.orderItems is list && order.orderItems.size() > 0
        && order.totalAmount is number && order.totalAmount > 0;
    }

    match /users/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.id == uid
        && request.resource.data.email == request.auth.token.email;
    }

    match /orders/{email} {
      allow get: if ownsOrders(email);
      allow create: if ownsOrders(email)
        && request.resource.data.keys().hasOnly(['orders'])
        && validNewOrder(email)
        && request.resource.data.orders.size() == 1;
      allow update: if ownsOrders(email)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['orders'])
        && validNewOrder(email)
        && request.resource.data.orders.size() == resource.data.orders.size() + 1
        && request.resource.data.orders.removeAll([request.resource.data.orders[request.resource.data.orders.size() - 1]]) == resource.data.orders;
    }
  }
}
